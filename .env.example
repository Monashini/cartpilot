# PayPal sandbox app credentials: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
CURRENCY=USD

# Google Gemini API key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Backup free models, each with its own daily quota; used when the one above runs out
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Product catalog: "dummyjson" (default, adds ~190 products with photos) or "local" (catalog.json only)
CATALOG_SOURCE=dummyjson

PORT=3000
